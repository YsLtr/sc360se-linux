    def _build_dpi_section(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        title = Gtk.Label(label="DPI stages")
        title.set_xalign(0); title.add_css_class("section-title")
        box.append(title)

        topline = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        topline.append(Gtk.Label(label="Active:"))
        self.dpi_active_combo = Gtk.DropDown.new_from_strings(
            [f"Stage {i}" for i in range(NSTAGES)])
        self.dpi_active_combo.connect("notify::selected",
            lambda *_: (self._sync_field("dpi_active",
                                         self.dpi_active_combo.get_selected()),
                        self._write_dpi() if not self._guard else None))
        topline.append(self.dpi_active_combo)

        topline.append(Gtk.Label(label="Enabled count:"))
        self.dpi_count_spin = Gtk.SpinButton.new_with_range(1, NSTAGES, 1)
        self.dpi_count_spin.connect("value-changed",
            lambda w: (self._sync_field("dpi_count", int(w.get_value())),
                       self._update_stage_sensitivity(),
                       self._write_dpi() if not self._guard else None))
        topline.append(self.dpi_count_spin)
        box.append(topline)

        self.stage_rows = []
        for i in range(NSTAGES):
            row = self._build_stage_row(i)
            self.stage_rows.append(row)
            box.append(row["box"])
        return box

    def _build_stage_row(self, i):
        b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        b.add_css_class("stage-row")

        label = Gtk.Label(label=f"Stage {i}")
        label.set_xalign(0); label.set_size_request(80, -1)
        b.append(label)

        spin = Gtk.SpinButton.new_with_range(100, 26000, 100)
        spin.set_size_request(120, -1)
        b.append(spin)

        slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,
                                          100, 26000, 100)
        slider.set_hexpand(True)
        slider.set_draw_value(False)
        b.append(slider)

        def on_spin(_w):
            v = snap_dpi(int(spin.get_value()))
            if not self._guard:
                debug(f"stage {i} spin changed: {v}")
                self.profile.stages[i].x_cpi = v
                self.profile.stages[i].y_cpi = v
                self._debounce(self._write_dpi)
            was_guard = self._guard
            self._guard = True
            spin.set_value(v); slider.set_value(v)
            self._guard = was_guard

        def on_slider(_w):
            v = snap_dpi(int(slider.get_value()))
            if not self._guard:
                debug(f"stage {i} slider changed: {v}")
                self.profile.stages[i].x_cpi = v
                self.profile.stages[i].y_cpi = v
                self._debounce(self._write_dpi)
            was_guard = self._guard
            self._guard = True
            spin.set_value(v); slider.set_value(v)
            self._guard = was_guard

        spin.connect("value-changed", on_spin)
        slider.connect("value-changed", on_slider)

        rgb_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        r_spin = Gtk.SpinButton.new_with_range(0, 255, 1)
        g_spin = Gtk.SpinButton.new_with_range(0, 255, 1)
        b_spin = Gtk.SpinButton.new_with_range(0, 255, 1)
        for text, w in (("R", r_spin), ("G", g_spin), ("B", b_spin)):
            rgb_box.append(Gtk.Label(label=text))
            w.set_size_request(66, -1)
            rgb_box.append(w)

        preview = Gtk.DrawingArea()
        preview.set_content_width(36)
        preview.set_content_height(24)
        preview.set_tooltip_text("Exact RGB preview written to the mouse")
        def draw_preview(_area, cr, width, height):
            r, g, bb = rgb_hex_to_tuple(self.profile.stages[i].rgb)
            cr.set_source_rgb(r / 255.0, g / 255.0, bb / 255.0)
            cr.rectangle(0, 0, width, height)
            cr.fill()
            cr.set_source_rgba(0, 0, 0, 0.45)
            cr.set_line_width(1)
            cr.rectangle(0.5, 0.5, max(0, width - 1), max(0, height - 1))
            cr.stroke()
        preview.set_draw_func(draw_preview)
        rgb_box.append(preview)

        def on_rgb(*_):
            if not self._guard:
                self.profile.stages[i].rgb = rgb_tuple_to_hex(
                    int(r_spin.get_value()),
                    int(g_spin.get_value()),
                    int(b_spin.get_value()))
                debug(f"stage {i} RGB changed: {self.profile.stages[i].rgb}")
                self._debounce(self._write_colors)
            preview.queue_draw()
        r_spin.connect("value-changed", on_rgb)
        g_spin.connect("value-changed", on_rgb)
        b_spin.connect("value-changed", on_rgb)
        b.append(rgb_box)

        led_chk = Gtk.CheckButton(label="LED")
        led_chk.set_tooltip_text(
            "Store this stage's DPI color flag. The light-mode command is "
            "sent separately for LED experiments.")
        def on_led(_w):
            if not self._guard:
                self.profile.stages[i].flag = 0xff if led_chk.get_active() else 0x00
                debug(f"stage {i} LED flag changed: {self.profile.stages[i].flag:02x}")
                self._write_colors()
        led_chk.connect("toggled", on_led)
        b.append(led_chk)

        return {"box": b, "spin": spin, "slider": slider,
                "r": r_spin, "g": g_spin, "b": b_spin,
                "preview": preview, "led": led_chk, "label": label}

    def _build_buttons_section(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        title = Gtk.Label(label="Buttons")
        title.set_xalign(0); title.add_css_class("section-title")
        box.append(title)

        self.button_rows = []
        for i, name in enumerate(BUTTON_LABELS):
            row = self._build_button_row(i, name)
            if i == 5:
                row["box"].set_sensitive(False)
                row["box"].set_tooltip_text(
                    "The physical DPI key is handled by firmware. Captures show "
                    "that remapping it can disable local DPI switching until a "
                    "factory reset, so the GUI keeps it locked.")
            self.button_rows.append(row)
            box.append(row["box"])
        return box

    def _build_button_row(self, i, name):
        b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        label = Gtk.Label(label=name)
        label.set_xalign(0); label.set_size_request(110, -1)
        b.append(label)

        type_combo = Gtk.DropDown.new_from_strings(
            [t[1] for t in ACTION_TYPES])
        b.append(type_combo)

        # Stack of param widgets — one row per type, swapped via reveal
        stack = Gtk.Stack()
        stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        stack.set_hexpand(True)

        # mouse: single dropdown
        m_combo = Gtk.DropDown.new_from_strings([m[1] for m in MOUSE_BUTTONS])
        m_combo.connect("notify::selected",
            lambda *_: self._set_button(i, "mouse",
                                        MOUSE_BUTTONS[m_combo.get_selected()][0], 0))
        stack.add_named(m_combo, "mouse")

        # dpi:
        d_combo = Gtk.DropDown.new_from_strings([d[1] for d in DPI_ACTIONS])
        d_combo.connect("notify::selected",
            lambda *_: self._set_button(i, "dpi",
                                        DPI_ACTIONS[d_combo.get_selected()][0], 0))
        stack.add_named(d_combo, "dpi")

        # disable:
        dis = Gtk.Label(label="(no parameters)")
        dis.add_css_class("muted")
        stack.add_named(dis, "disable")

        # key: usage + modifier checkboxes
        krow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        k_combo = Gtk.DropDown.new_from_strings([k[1] for k in HID_KEYS])
        krow.append(k_combo)
        mod_chks = []
        for v, mn in KBD_MODS[:4]:    # show only Left modifiers in the row
            chk = Gtk.CheckButton(label=mn)
            chk.connect("toggled",
                lambda *_: self._update_key_button(i, k_combo, mod_chks))
            krow.append(chk)
            mod_chks.append((v, chk))
        k_combo.connect("notify::selected",
            lambda *_: self._update_key_button(i, k_combo, mod_chks))
        stack.add_named(krow, "key")

        # consumer:
        c_combo = Gtk.DropDown.new_from_strings([c[1] for c in CONSUMER_KEYS])
        def on_consumer(*_):
            usage = CONSUMER_KEYS[c_combo.get_selected()][0]
            self._set_button(i, "consumer", usage & 0xff, (usage >> 8) & 0xff)
        c_combo.connect("notify::selected", on_consumer)
        stack.add_named(c_combo, "consumer")

        b.append(stack)

        def on_type(*_):
            t = ACTION_TYPES[type_combo.get_selected()][0]
            stack.set_visible_child_name(t)
            # apply current widget state for that type
            if t == "mouse":
                self._set_button(i, "mouse",
                                 MOUSE_BUTTONS[m_combo.get_selected()][0], 0)
            elif t == "dpi":
                self._set_button(i, "dpi",
                                 DPI_ACTIONS[d_combo.get_selected()][0], 0)
            elif t == "disable":
                self._set_button(i, "disable", 0, 0)
            elif t == "key":
                self._update_key_button(i, k_combo, mod_chks)
            elif t == "consumer":
                usage = CONSUMER_KEYS[c_combo.get_selected()][0]
                self._set_button(i, "consumer", usage & 0xff, (usage >> 8) & 0xff)
        type_combo.connect("notify::selected", on_type)

        return {"box": b, "type": type_combo, "stack": stack,
                "m": m_combo, "d": d_combo, "k": k_combo, "c": c_combo,
                "mods": mod_chks}

