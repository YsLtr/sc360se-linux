class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.sc360se.gui",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        try:
            cli = find_cli()
        except FileNotFoundError as e:
            d = Gtk.AlertDialog()
            d.set_message("sc360se binary not found")
            d.set_detail("Build the C driver first: `make` in this directory,\n"
                         "or install it system-wide.")
            d.show()
            return

        profiles_dir = Path.home() / ".config" / "sc360se"
        profiles_dir.mkdir(parents=True, exist_ok=True)
        # If running from source tree and no user profiles yet, seed them.
        seed = HERE / "profiles"
        if seed.exists() and not list(profiles_dir.glob("*.cfg")):
            for f in seed.glob("*.cfg"):
                shutil.copy(f, profiles_dir / f.name)

        win = Sc360seWindow(self, cli, profiles_dir)
        win.present()

if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
