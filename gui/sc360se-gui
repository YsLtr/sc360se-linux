HERE = Path(__file__).resolve().parent
ROOT = HERE.parent

def debug(msg: str):
    ts = time.strftime("%H:%M:%S")
    print(f"[sc360se-gui {ts}] {msg}", file=sys.stderr, flush=True)

def find_cli() -> Path:
    # Prefer the freshly-built binary in the project root
    local = ROOT / "sc360se"
    if local.exists() and os.access(local, os.X_OK):
        debug(f"using CLI from source tree: {local}")
        return local
    sys_ = shutil.which("sc360se")
    if sys_:
        debug(f"using CLI from PATH: {sys_}")
        return Path(sys_)
    raise FileNotFoundError("sc360se binary not found (build it first or add to PATH)")

class CliError(RuntimeError):
    pass

def run_cli(cli: Path, *args, timeout=15) -> str:
    cmd = " ".join([str(cli), *args])
    debug(f"RUN {cmd}")
    env = os.environ.copy()
    env.setdefault("SC360SE_DEBUG", "1")
    try:
        r = subprocess.run([str(cli), *args],
                           capture_output=True, text=True, timeout=timeout,
                           env=env)
    except subprocess.TimeoutExpired as e:
        debug(f"TIMEOUT {cmd}")
        raise CliError(f"timeout running: sc360se {' '.join(args)}") from e
    stdout = (r.stdout or "").strip()
    stderr = (r.stderr or "").strip()
    debug(f"EXIT {r.returncode} {cmd}")
    if stdout:
        debug("STDOUT\n" + stdout)
    if stderr:
        debug("STDERR\n" + stderr)
    if r.returncode != 0:
        combined = [line.strip() for line in (stderr + "\n" + stdout).splitlines()
                    if line.strip()]
        msg = next((line for line in reversed(combined)
                    if line.startswith("error:")), None)
        if msg is None:
            msg = (stderr or stdout or "unknown error").strip()
        raise CliError(msg)
    return r.stdout

