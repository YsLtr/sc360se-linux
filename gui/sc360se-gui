class Sc360seWindow(Gtk.ApplicationWindow):
    def __init__(self, app, cli: Path, profiles_dir: Path):
        super().__init__(application=app, title="AULA SC360SE")
        self.set_default_size(740, 880)
        self.cli = cli
        self.profiles_dir = profiles_dir
        self.profile = Profile.default()
        self._guard = False  # stop signal feedback during programmatic UI sync
        self._guard_depth = 0
        self._write_enabled = False
        self._startup_refresh_done = False
        self._debounce_src = None
        self._enable_writes_src = None
        self._watch_proc = None
        self._watch_tag = None
        self._watch_err_tag = None
        self.connect("close-request", self._on_close)
        debug(f"window init: profiles_dir={profiles_dir}")

        # CSS
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Header
        hdr = Gtk.HeaderBar()
        self.set_titlebar(hdr)

        self.refresh_btn = Gtk.Button.new_from_icon_name("view-refresh-symbolic")
        self.refresh_btn.set_tooltip_text("Read current config from device")
        self.refresh_btn.connect("clicked", lambda *_: self.refresh_device())
        hdr.pack_start(self.refresh_btn)

        # Body
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_hexpand(True); scrolled.set_vexpand(True)
        self.set_child(scrolled)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                       margin_start=20, margin_end=20,
                       margin_top=18, margin_bottom=18)
        scrolled.set_child(body)

        body.append(self._build_status())
        body.append(self._build_profile_bar())
        body.append(Gtk.Separator())
        body.append(self._build_dpi_section())
        body.append(Gtk.Separator())
        body.append(self._build_buttons_section())
        body.append(Gtk.Separator())
        body.append(self._build_misc_section())
        body.append(Gtk.Separator())
        body.append(self._build_danger_section())

        # Toast/status
        self.info = Gtk.Label(label="")
        self.info.set_xalign(0)
        self.info.add_css_class("muted")
        body.append(self.info)

        # Initial state
        self.sync_ui_from_profile()
        self.connect("map", self._on_map)

    def _on_map(self, *_):
        if self._startup_refresh_done:
            debug("map: startup refresh already done; ignoring duplicate map signal")
            return
        self._startup_refresh_done = True
        debug("map: window mapped; scheduling startup refresh")
        GLib.idle_add(self.refresh_device)

