# Helpers
# ─────────────────────────────────────────────────────────────────────

def snap_dpi(value: int) -> int:
    """Match the firmware quantization: 100 below 5000, 500 from 5000 up."""
    if value <= 100: return 100
    if value >= 26000: value = 26000
    if value < 5000:
        return (value // 100) * 100
    return (value // 500) * 500

def rgb_hex_to_tuple(rgb_hex: str):
    h = rgb_hex.lstrip("#")
    if len(h) != 6:
        return 255, 255, 255
    return tuple(bytes.fromhex(h))

def rgb_tuple_to_hex(r: int, g: int, b: int) -> str:
    return "#%02X%02X%02X" % (max(0, min(255, r)),
                              max(0, min(255, g)),
                              max(0, min(255, b)))

def profile_summary(p: Profile) -> str:
    dpi = ", ".join(f"{i}:{s.x_cpi}/{s.y_cpi} {s.rgb} f={s.flag:02x}"
                    for i, s in enumerate(p.stages))
    buttons = ", ".join(f"{i}:{b.type}/{b.p1:02x}/{b.p2:02x}"
                        for i, b in enumerate(p.buttons))
    return (f"polling={p.polling} sleep={p.sleep_seconds} "
            f"light={p.light_mode} "
            f"active={p.dpi_active} count={p.dpi_count} "
            f"dpi=[{dpi}] buttons=[{buttons}]")

