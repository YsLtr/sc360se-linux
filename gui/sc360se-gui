@dataclass
class Stage:
    x_cpi: int = 1600
    y_cpi: int = 1600
    rgb: str = "#FFFFFF"
    flag: int = 0xff

@dataclass
class Button:
    type: str = "mouse"
    p1: int = 0
    p2: int = 0

@dataclass
class Profile:
    polling: int = 1000
    light_mode: int = 2
    sleep_seconds: int = 90
    dpi_active: int = 0
    dpi_count: int = 5
    stages: list = field(default_factory=lambda: [Stage() for _ in range(NSTAGES)])
    buttons: list = field(default_factory=lambda: [
        Button("mouse", 0x01, 0), Button("mouse", 0x02, 0),
        Button("mouse", 0x04, 0), Button("mouse", 0x08, 0),
        Button("mouse", 0x10, 0), Button("dpi", 0x01, 0),
    ])

    @classmethod
    def default(cls):
        p = cls()
        defaults = [800, 1600, 2400, 3200, 5200, 6000]
        for i, c in enumerate(defaults):
            p.stages[i].x_cpi = c
            p.stages[i].y_cpi = c
        return p

    @classmethod
    def load(cls, path: Path):
        p = cls.default()
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.split("#", 1)[0].strip() if "=" in raw else raw.strip()
            # keep '#' for color values — strip comments only after key=
            if "=" not in raw:
                continue
            k, _, v = raw.partition("=")
            k = k.strip()
            v = v.strip()
            # strip trailing comment that appears after color (we rely on
            # color spec coming before any '#' that's a comment)
            if k.startswith("dpi.stage[") or k.startswith("button["):
                pass
            else:
                if "#" in v:
                    v = v.split("#", 1)[0].strip()

            if k == "polling":
                p.polling = int(v)
            elif k == "light.mode":
                mode = int(v.split()[0], 0)
                if 1 <= mode <= 6:
                    p.light_mode = mode
            elif k == "sleep":
                p.sleep_seconds = int(v)
            elif k == "dpi.active":
                p.dpi_active = int(v)
            elif k == "dpi.count":
                p.dpi_count = int(v)
            elif k.startswith("dpi.stage["):
                m = re.match(r"dpi\.stage\[(\d+)\]", k)
                if not m: continue
                idx = int(m.group(1))
                if idx < 0 or idx >= NSTAGES: continue
                m = re.search(r"(\d+)\s*/\s*(\d+)\s*#([0-9a-fA-F]{6})\s*flag\s*=\s*([0-9a-fA-F]+)", v)
                if not m: continue
                p.stages[idx].x_cpi = int(m.group(1))
                p.stages[idx].y_cpi = int(m.group(2))
                p.stages[idx].rgb   = "#" + m.group(3).upper()
                p.stages[idx].flag  = int(m.group(4), 16)
            elif k.startswith("button["):
                m = re.match(r"button\[(\d+)", k)
                if not m: continue
                idx = int(m.group(1))
                if idx < 0 or idx >= NBUTTONS: continue
                parts = v.split()
                if len(parts) < 3: continue
                p.buttons[idx].type = parts[0]
                p.buttons[idx].p1 = int(parts[1], 16)
                p.buttons[idx].p2 = int(parts[2], 16)
        return p

    @classmethod
    def from_device_text(cls, text: str):
        """Parse the output of `sc360se read` into a Profile."""
        p = cls.default()
        seen = set()
        stage_seen = set()
        button_seen = set()
        for raw in text.splitlines():
            line = raw.strip()
            if not line or ":" not in line:
                continue
            k, _, v = line.partition(":")
            k, v = k.strip(), v.strip()
            if k == "polling":
                p.polling = int(v.split()[0])
                seen.add("polling")
            elif k == "sleep":
                p.sleep_seconds = int(v.rstrip("s").strip())
                seen.add("sleep")
            elif k == "light.mode":
                p.light_mode = int(v.split()[0], 0)
                seen.add("light.mode")
            elif k == "dpi.active":
                p.dpi_active = int(v)
                seen.add("dpi.active")
            elif k == "dpi.count":
                p.dpi_count = int(v)
                seen.add("dpi.count")
            elif k.startswith("dpi["):
                m = re.match(r"dpi\[(\d+)\]", k)
                if not m: continue
                idx = int(m.group(1))
                if idx < 0 or idx >= NSTAGES: continue
                m2 = re.search(r"(\d+)\s*/\s*(\d+)\s*#([0-9a-fA-F]{6})\s*flag\s*=\s*([0-9a-fA-F]+)", v)
                if not m2: continue
                p.stages[idx].x_cpi = int(m2.group(1))
                p.stages[idx].y_cpi = int(m2.group(2))
                p.stages[idx].rgb   = "#" + m2.group(3).upper()
                p.stages[idx].flag  = int(m2.group(4), 16)
                stage_seen.add(idx)
            elif k.startswith("button["):
                m = re.match(r"button\[(\d+)", k)
                if not m: continue
                idx = int(m.group(1))
                if idx < 0 or idx >= NBUTTONS: continue
                parts = v.split()
                if len(parts) < 3: continue
                p.buttons[idx].type = parts[0]
                p.buttons[idx].p1 = int(parts[1], 16)
                p.buttons[idx].p2 = int(parts[2], 16)
                button_seen.add(idx)

        missing = []
        for name in ("polling", "sleep", "dpi.active", "dpi.count"):
            if name not in seen:
                missing.append(name)
        missing.extend(f"dpi[{i}]" for i in range(NSTAGES) if i not in stage_seen)
        missing.extend(f"button[{i}]" for i in range(NBUTTONS) if i not in button_seen)
        if missing:
            raise ValueError("incomplete device read; missing " + ", ".join(missing))
        return p

    def save(self, path: Path):
        lines = ["# AULA SC360SE profile",
                 f"polling = {self.polling}",
                 f"light.mode = {self.light_mode}",
                 f"sleep   = {self.sleep_seconds}",
                 f"dpi.active = {self.dpi_active}",
                 f"dpi.count  = {self.dpi_count}"]
        for i, s in enumerate(self.stages):
            r, g, b = bytes.fromhex(s.rgb.lstrip("#"))
            lines.append(f"dpi.stage[{i}] = {s.x_cpi}/{s.y_cpi}  "
                         f"#{r:02X}{g:02X}{b:02X}  flag={s.flag:02x}")
        names = ["left","right","wheel","back-side","front-side","dpi-key"]
        for i, b in enumerate(self.buttons):
            lines.append(f"button[{i} {names[i]}] = {b.type} {b.p1:02x} {b.p2:02x}")
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")

