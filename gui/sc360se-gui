    # ─── state plumbing ────────────────────────────────────────────

    def _enter_guard(self, reason: str):
        self._guard_depth += 1
        debug(f"guard enter({self._guard_depth}): {reason}")
        self._guard = True

    def _leave_guard_later(self, reason: str):
        debug(f"guard release scheduled: {reason}")
        GLib.idle_add(self._clear_guard, reason)

    def _write_allowed(self, name: str) -> bool:
        if self._guard:
            debug(f"SKIP WRITE {name}: guard active")
            return False
        if not self._write_enabled:
            debug(f"SKIP WRITE {name}: device writes disabled until a complete read succeeds")
            return False
        return True

    def _enable_writes_later(self, reason: str, ms=300):
        if self._enable_writes_src:
            GLib.source_remove(self._enable_writes_src)
        debug(f"device writes will be enabled in {ms} ms: {reason}")
        self._enable_writes_src = GLib.timeout_add(ms, self._enable_writes, reason)

    def _enable_writes(self, reason: str):
        self._enable_writes_src = None
        if self._guard:
            debug(f"device writes not enabled yet; guard still active: {reason}")
            self._enable_writes_later(reason, 100)
            return False
        self._write_enabled = True
        debug(f"device writes enabled: {reason}")
        return False

    def _sync_field(self, attr, value):
        if not self._guard:
            debug(f"sync field from UI: {attr}={value}")
            setattr(self.profile, attr, value)

    def _set_button(self, idx, type_name, p1, p2):
        if self._guard: return
        debug(f"button UI changed: idx={idx} type={type_name} p1={p1:02x} p2={p2:02x}")
        self.profile.buttons[idx].type = type_name
        self.profile.buttons[idx].p1 = p1
        self.profile.buttons[idx].p2 = p2
        self._write_buttons()

    def _update_key_button(self, idx, k_combo, mod_chks):
        usage = HID_KEYS[k_combo.get_selected()][0]
        mod = 0
        for v, chk in mod_chks:
            if chk.get_active():
                mod |= v
        self._set_button(idx, "key", mod, usage)

    def _update_stage_sensitivity(self):
        for i, row in enumerate(self.stage_rows):
            on = i < self.profile.dpi_count
            row["box"].set_sensitive(on)
            (row["box"].remove_css_class("disabled") if on
             else row["box"].add_css_class("disabled"))

    def _clear_guard(self, reason=""):
        if self._guard_depth > 0:
            self._guard_depth -= 1
        self._guard = self._guard_depth > 0
        debug(f"guard leave({self._guard_depth}): {reason}")
        return False

    def sync_ui_from_profile(self):
        self._enter_guard("sync_ui_from_profile")
        debug("sync UI from profile: " + profile_summary(self.profile))
        try:
            # polling
            try:
                self.polling_combo.set_selected(POLLING_RATES.index(self.profile.polling))
            except ValueError:
                self.polling_combo.set_selected(POLLING_RATES.index(1000))
            light_idx = next((i for i, (mode, _) in enumerate(LIGHT_MODES)
                              if mode == self.profile.light_mode), 1)
            self.light_combo.set_selected(light_idx)
            # sleep
            self.sleep_spin.set_value(self.profile.sleep_seconds)
            # dpi
            self.dpi_active_combo.set_selected(min(self.profile.dpi_active, NSTAGES-1))
            self.dpi_count_spin.set_value(self.profile.dpi_count)
            for i, s in enumerate(self.profile.stages):
                self.stage_rows[i]["spin"].set_value(s.x_cpi)
                self.stage_rows[i]["slider"].set_value(s.x_cpi)
                r, g, b = rgb_hex_to_tuple(s.rgb)
                self.stage_rows[i]["r"].set_value(r)
                self.stage_rows[i]["g"].set_value(g)
                self.stage_rows[i]["b"].set_value(b)
                self.stage_rows[i]["preview"].queue_draw()
                self.stage_rows[i]["led"].set_active(s.flag == 0xff)
            self._update_stage_sensitivity()
            # buttons
            for i, btn in enumerate(self.profile.buttons):
                row = self.button_rows[i]
                # type
                idx = next((j for j,(k,_) in enumerate(ACTION_TYPES) if k == btn.type), 0)
                row["type"].set_selected(idx)
                row["stack"].set_visible_child_name(btn.type)
                if btn.type == "mouse":
                    j = next((k for k,(b,_) in enumerate(MOUSE_BUTTONS) if b == btn.p1), 0)
                    row["m"].set_selected(j)
                elif btn.type == "dpi":
                    j = next((k for k,(b,_) in enumerate(DPI_ACTIONS) if b == btn.p1), 0)
                    row["d"].set_selected(j)
                elif btn.type == "key":
                    j = next((k for k,(u,_) in enumerate(HID_KEYS) if u == btn.p2), 0)
                    row["k"].set_selected(j)
                    for v, chk in row["mods"]:
                        chk.set_active(bool(btn.p1 & v))
                elif btn.type == "consumer":
                    usage = btn.p1 | (btn.p2 << 8)
                    j = next((k for k,(u,_) in enumerate(CONSUMER_KEYS) if u == usage), 0)
                    row["c"].set_selected(j)
        finally:
            self._leave_guard_later("sync_ui_from_profile")

    def _profile_paths(self):
        return sorted(self.profiles_dir.glob("*.cfg"))

    def _reload_profile_list(self):
        self._enter_guard("reload_profile_list")
        try:
            files = self._profile_paths()
            debug("reload profile list: " + ", ".join(str(f) for f in files))
            names = [f.stem for f in files] or ["(no profiles)"]
            sm = Gtk.StringList.new(names)
            self.profile_combo.set_model(sm)
            self.profile_combo.set_sensitive(bool(files))
        finally:
            self._leave_guard_later("reload_profile_list")

    def _on_profile_selected(self):
        if self._guard: return
        # selection only — load on demand

    def _on_profile_load(self):
        files = self._profile_paths()
        if not files:
            self.notify("No saved profiles", err=True); return
        idx = self.profile_combo.get_selected()
        if idx < 0 or idx >= len(files): return
        try:
            self.profile = Profile.load(files[idx])
        except Exception as e:
            self.notify(f"Load failed: {e}", err=True); return
        self.sync_ui_from_profile()
        self.notify(f"Loaded {files[idx].name}")

    def _on_profile_save_as(self):
        dlg = Gtk.Window(transient_for=self, title="Save profile as", modal=True)
        dlg.set_default_size(360, 100)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                      margin_start=14, margin_end=14, margin_top=14, margin_bottom=14)
        dlg.set_child(box)
        entry = Gtk.Entry()
        entry.set_placeholder_text("profile name (e.g. fps)")
        box.append(entry)
        btnrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                         spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: dlg.destroy())
        ok = Gtk.Button(label="Save"); ok.add_css_class("suggested-action")
        def do_save(*_):
            name = entry.get_text().strip()
            if not name:
                return
            path = self.profiles_dir / f"{name}.cfg"
            try:
                self.profile.save(path)
            except Exception as e:
                self.notify(f"Save failed: {e}", err=True)
            else:
                self._reload_profile_list()
                self.notify(f"Saved {path.name}")
            dlg.destroy()
        ok.connect("clicked", do_save)
        entry.connect("activate", do_save)
        btnrow.append(cancel); btnrow.append(ok)
        box.append(btnrow)
        dlg.present()

    def _on_profile_delete(self):
        files = self._profile_paths()
        if not files: return
        idx = self.profile_combo.get_selected()
        if idx < 0 or idx >= len(files): return
        path = files[idx]
        try:
            path.unlink()
        except Exception as e:
            self.notify(f"Delete failed: {e}", err=True); return
        self._reload_profile_list()
        self.notify(f"Deleted {path.name}")

    # ─── device ────────────────────────────────────────────────────

    def refresh_device(self):
        debug("refresh_device: begin")
        self._stop_watch()
        self._write_enabled = False
        debug("device writes disabled during refresh")
        if self._enable_writes_src:
            debug("cancelling pending write-enable timer before refresh")
            GLib.source_remove(self._enable_writes_src)
            self._enable_writes_src = None
        if self._debounce_src:
            debug("cancelling pending debounced write before refresh")
            GLib.source_remove(self._debounce_src)
            self._debounce_src = None
        try:
            out = run_cli(self.cli, "read")
            loaded = Profile.from_device_text(out)
            debug("refresh_device: parsed complete device profile: " + profile_summary(loaded))
            self.profile = loaded
            self.sync_ui_from_profile()
            self._enable_writes_later("successful complete device read")

            self.dot.remove_css_class("muted")
            self.dot.remove_css_class("error")
            self.dot.add_css_class("success")

            # Extract device-info header lines for the status bar
            info_parts = []
            for line in out.splitlines():
                line = line.strip()
                if line.startswith("hidraw") or line.startswith("vid:pid") or \
                   line.startswith("link") or line.startswith("device"):
                    info_parts.append(line)
            self.status_label.set_text("  ·  ".join(info_parts))

            self._start_watch()
        except (CliError, FileNotFoundError, ValueError) as e:
            debug(f"refresh_device: failed: {e}")
            self.dot.remove_css_class("success")
            self.dot.add_css_class("error")
            self.status_label.set_text(f"Not connected: {e}")
            self.battery_label.set_text("")
            self._write_enabled = False
            if self._enable_writes_src:
                GLib.source_remove(self._enable_writes_src)
                self._enable_writes_src = None
            debug("device writes remain disabled because refresh failed")
            self._start_watch()
        return False

    def _start_watch(self):
        """Spawn `sc360se watch` as a background subprocess to receive
        unsolicited DPI-change and battery notifications from the mouse."""
        if hasattr(self, '_watch_proc') and self._watch_proc is not None:
            debug("watch: already running")
            return
        try:
            debug(f"watch: starting {self.cli} watch")
            env = os.environ.copy()
            env.setdefault("SC360SE_DEBUG", "1")
            self._watch_proc = subprocess.Popen(
                [str(self.cli), "watch"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                env=env,
                text=True, bufsize=1)
            self._watch_tag = GLib.io_add_watch(
                self._watch_proc.stdout,
                GLib.IO_IN | GLib.IO_HUP,
                self._on_watch_output)
            self._watch_err_tag = GLib.io_add_watch(
                self._watch_proc.stderr,
                GLib.IO_IN | GLib.IO_HUP,
                self._on_watch_stderr)
        except Exception as e:
            debug(f"watch: failed to start: {e}")

    def _on_watch_stderr(self, source, condition):
        if condition & GLib.IO_HUP:
            self._watch_err_tag = None
            return False
        line = source.readline()
        if not line:
            self._watch_err_tag = None
            return False
        debug("watch stderr: " + line.rstrip())
        return True

    def _on_watch_output(self, source, condition):
        if condition & GLib.IO_HUP:
            debug("watch: HUP")
            self._stop_watch()
            return False
        line = source.readline()
        if not line:
            debug("watch: EOF")
            self._stop_watch()
            return False
        line = line.strip()
        debug(f"watch: {line}")
        # dpi: stage 2/6 → 2400 cpi
        if line.startswith("dpi: stage "):
            import re
            m = re.match(r"dpi: stage (\d+)/(\d+) → (\d+) cpi", line)
            if m:
                active = int(m.group(1))
                if active != self.profile.dpi_active:
                    self.profile.dpi_active = active
                    self._enter_guard("watch dpi event")
                    try:
                        self.dpi_active_combo.set_selected(active)
                    finally:
                        self._leave_guard_later("watch dpi event")
        # battery: 92%
        elif line.startswith("battery: "):
            pct = line.split(": ", 1)[1].rstrip("%")
            self.battery_label.set_text(f"Battery: {pct}")
        elif line == "link: disconnected":
            self._write_enabled = False
            self.dot.remove_css_class("success")
            self.dot.add_css_class("error")
            self.status_label.set_text("Mouse disconnected or asleep")
        elif line == "link: connected":
            self.dot.remove_css_class("error")
            self.dot.add_css_class("muted")
            if not self._write_enabled:
                debug("watch: link connected; scheduling refresh")
                GLib.timeout_add(250, self.refresh_device)
        return True

    def _stop_watch(self):
        if hasattr(self, '_watch_tag') and self._watch_tag:
            debug("watch: removing GLib source")
            GLib.source_remove(self._watch_tag)
            self._watch_tag = None
        if hasattr(self, '_watch_err_tag') and self._watch_err_tag:
            debug("watch: removing stderr GLib source")
            GLib.source_remove(self._watch_err_tag)
            self._watch_err_tag = None
        if hasattr(self, '_watch_proc') and self._watch_proc:
            try:
                debug("watch: terminating subprocess")
                self._watch_proc.terminate()
                self._watch_proc.wait(timeout=2)
            except Exception:
                try:
                    debug("watch: killing subprocess")
                    self._watch_proc.kill()
                except Exception:
                    pass
            self._watch_proc = None

    def _run_write_commands(self, commands):
        was_watching = getattr(self, "_watch_proc", None) is not None
        if was_watching:
            debug("watch: pausing for foreground write")
            self._stop_watch()
        try:
            for args, timeout in commands:
                run_cli(self.cli, *args, timeout=timeout)
        finally:
            if was_watching:
                debug("watch: restarting after foreground write")
                GLib.timeout_add(150, self._restart_watch_after_write)

    def _restart_watch_after_write(self):
        self._start_watch()
        return False

    def _on_close(self, *_):
        self._stop_watch()
        return False  # let default handler destroy the window

    # ─── immediate writes ──────────────────────────────────────────

    def _debounce(self, callback, ms=250):
        """Debounce rapid-fire changes (sliders etc.) before writing."""
        if hasattr(self, '_debounce_src') and self._debounce_src:
            debug("debounce: replacing pending write")
            GLib.source_remove(self._debounce_src)
        debug(f"debounce: scheduling {callback.__name__} in {ms} ms")
        self._debounce_src = GLib.timeout_add(ms, self._run_debounced, callback)

    def _run_debounced(self, callback):
        self._debounce_src = None
        debug(f"debounce: running {callback.__name__}")
        try:
            callback()
        except CliError as e:
            debug(f"debounce: {callback.__name__} failed: {e}")
        return False

    def _write_dpi(self):
        if not self._write_allowed("dpi"):
            return
        p = self.profile
        parts = [str(p.dpi_active), str(p.dpi_count)]
        for s in p.stages:
            parts.append(f"{s.x_cpi}/{s.y_cpi}")
        debug("WRITE dpi: " + " ".join(parts))
        self._run_write_commands([
            (("dpi", *parts), 5),
            (self._light_mode_command(), 5),
        ])

    def _write_colors(self):
        if not self._write_allowed("colors"):
            return
        p = self.profile
        parts = []
        for s in p.stages:
            r, g, b = rgb_hex_to_tuple(s.rgb)
            parts.append(f"{r:02x}/{g:02x}/{b:02x}/{s.flag:02x}")
        debug("WRITE colors: " + " ".join(parts))
        self._run_write_commands([
            (("write-colors", *parts), 5),
            (self._light_mode_command(), 5),
        ])

    def _write_buttons(self):
        if not self._write_allowed("buttons"):
            return
        parts = []
        for b in self.profile.buttons:
            tc = ACTION_TYPE_CODE.get(b.type, 0)
            parts.append(f"{tc:02x}/{b.p1:02x}/{b.p2:02x}")
        debug("WRITE buttons: " + " ".join(parts))
        self._run_write_commands([
            (("write-buttons", *parts), 5),
            (self._light_mode_command(), 5),
        ])

    def _write_polling(self):
        if not self._write_allowed("polling"):
            return
        debug(f"WRITE polling: {self.profile.polling}")
        self._run_write_commands([
            (("polling", str(self.profile.polling)), 5),
            (self._light_mode_command(), 5),
        ])

    def _write_light_mode(self):
        if not self._write_allowed("light-mode"):
            return
        debug(f"WRITE light-mode: {self.profile.light_mode}")
        self._run_write_commands([
            (self._light_mode_command(), 5),
        ])

    def _write_sleep(self):
        if not self._write_allowed("sleep"):
            return
        debug(f"WRITE sleep: {self.profile.sleep_seconds}")
        self._run_write_commands([
            (("sleep", str(self.profile.sleep_seconds)), 5),
            (self._light_mode_command(), 5),
        ])

    def _light_mode_command(self):
        mode = self.profile.light_mode if 1 <= self.profile.light_mode <= 6 else 2
        return ("light-mode", str(mode))

    def do_factory_reset(self):
        dlg = Gtk.AlertDialog()
        dlg.set_message("Factory reset the mouse?")
        dlg.set_detail(
            "This sends the firmware factory-reset command captured from the "
            "Windows driver. It restores the hidden DPI-key state and may reset "
            "DPI stages, colors, polling rate, button mappings and sleep timeout."
        )
        dlg.set_buttons(["Cancel", "Factory reset"])
        dlg.set_cancel_button(0)
        dlg.set_default_button(1)

        def on_done(_dialog, result):
            try:
                choice = dlg.choose_finish(result)
            except Exception as e:
                self.notify(f"Factory reset cancelled: {e}", err=True)
                return
            if choice != 1:
                self.notify("Factory reset cancelled")
                return
            try:
                run_cli(self.cli, "factory-reset")
                self.notify("Factory reset sent; wait a few seconds, then press the DPI key")
            except CliError as e:
                self.notify(f"Factory reset failed: {e}", err=True)

        dlg.choose(self, None, on_done)

    def notify(self, msg, err=False):
        self.info.remove_css_class("error")
        if err: self.info.add_css_class("error")
        self.info.set_text(msg)
        # auto-clear after 4 s
        GLib.timeout_add_seconds(4, lambda: (self.info.set_text(""), False)[1])

